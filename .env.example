# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/demand_intelligence

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL (CORS)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage / Datasets
DATASET_STORAGE_PATH=./dataset
